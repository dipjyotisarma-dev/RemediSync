# ==============================================================================
# REMEDISYNC: DATABASE & SERVICE CONFIGURATION
# ==============================================================================

# Environment mode: development | production | test
ENVIRONMENT=development

# ------------------------------------------------------------------------------
# PostgreSQL Configuration (Local pgAdmin 4 / Production Supabase)
# ------------------------------------------------------------------------------
# Local PostgreSQL database (pgAdmin 4):
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/remedisync

# Production Supabase database:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# SQLite fallback (optional):
# DATABASE_URL=sqlite:///./data/remedisync.db

# ------------------------------------------------------------------------------
# API & Application Settings
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO
SECRET_KEY=remedisync-enterprise-secret-key-change-in-production
